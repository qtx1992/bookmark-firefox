{
  "manifest_version": 2,
  "name": "Bookmark - 简洁书签",
  "version": "1.2.3",
  "description": "简洁的书签管理器，独立窗口打开，多列布局、可调整大小、无滚动条浏览。",
  "browser_specific_settings": {
    "gecko": {
      "id": "bookmark.qtx1992@yahoo.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "bookmarks",
    "tabs",
    "storage"
  ],
  "browser_action": {
    "default_title": "Bookmark 简洁书签",
    "default_area": "navbar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
